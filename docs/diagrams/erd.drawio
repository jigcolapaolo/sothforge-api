        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n\n    USER {\n        UUID id PK\n        string username\n        string email\n        string passwordHash\n        string avatar\n        datetime lastLogin\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    ORGANIZATION {\n        UUID id PK\n        string name\n        string description\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    ORGANIZATION_MEMBER {\n        UUID id PK\n        UUID userId FK\n        UUID organizationId FK\n        enum role\n        datetime joinedAt\n    }\n\n    PROJECT {\n        UUID id PK\n        UUID organizationId FK\n        string name\n        string description\n        enum status\n        date startDate\n        date endDate\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    BOARD {\n        UUID id PK\n        UUID projectId FK\n        string name\n        int position\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    TASK {\n        UUID id PK\n        UUID boardId FK\n        UUID creatorId FK\n        UUID assignedUserId FK\n        string title\n        string description\n        enum status\n        enum priority\n        decimal estimatedHours\n        datetime dueDate\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    COMMENT {\n        UUID id PK\n        UUID taskId FK\n        UUID authorId FK\n        string content\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    LABEL {\n        UUID id PK\n        UUID organizationId FK\n        string name\n        string color\n        datetime createdAt\n        datetime updatedAt\n    }\n\n    TASK_LABEL {\n        UUID taskId FK\n        UUID labelId FK\n    }\n\n    %% Relaciones principales\n\n    USER ||--o{ ORGANIZATION_MEMBER : belongs_to\n    ORGANIZATION ||--o{ ORGANIZATION_MEMBER : has_members\n\n    ORGANIZATION ||--o{ PROJECT : owns\n    PROJECT ||--o{ BOARD : contains\n    BOARD ||--o{ TASK : contains\n\n    TASK ||--o{ COMMENT : has\n\n    USER ||--o{ COMMENT : writes\n\n    USER ||--o{ TASK : creates\n    USER ||--o{ TASK : assigned_to\n\n    ORGANIZATION ||--o{ LABEL : owns\n\n    TASK ||--o{ TASK_LABEL : has\n    LABEL ||--o{ TASK_LABEL : categorizes&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8WbozMBqpRDhr2TE16cf-0">
